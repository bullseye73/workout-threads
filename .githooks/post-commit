#!/usr/bin/env bash
# Git post-commit hook
# 커밋 직후 변경사항을 AI(Gemini CLI)로 자동 리뷰하여 터미널에 출력하고 BullsNote에 기록합니다.

set -e

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.cargo/bin:$PATH"

REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_NAME="$(basename "$REPO_ROOT")"
cd "$REPO_ROOT"

REV="$(git rev-parse --short HEAD)"
SUBJECT="$(git log -1 --pretty=%s)"
AUTHOR="$(git log -1 --pretty=%an)"
COMMIT_DATE="$(date '+%Y-%m-%d %H:%M:%S')"

echo ""
echo "🤖 [post-commit] 커밋 $REV ('$SUBJECT')에 대한 AI 코드 리뷰를 생성 중입니다..."

if ! command -v gemini &> /dev/null; then
  echo "⚠️  [post-commit] 'gemini' CLI를 찾을 수 없어 AI 리뷰를 건너뜁니다." >&2
  exit 0
fi

REVIEW_PROMPT="추가 도구나 파일 탐색을 일체 실행하지 말고, 오직 표준 입력(stdin)으로 전달된 커밋 diff 내용만을 바탕으로 코드 리뷰를 작성해줘.
저장소: $REPO_NAME

다음 형식의 깔끔한 마크다운으로 작성해줘:
1. **변경 요약**: 핵심 변경 목적과 주요 수정 사항 (2~3문장)
2. **모범 사례 / 장점**: 잘 구현된 부분, 아키텍처/보안/테스트/성능 등
3. **개선 제안 / 주의점**: 잠재적 버그, 예외 처리, 리팩터링 제안
4. **한 줄 총평**"

# diff를 파이프로 gemini에 전달 (도구 호출 없이 /tmp에서 고속 실행)
REVIEW="$(git show --stat -p -M --no-color HEAD | head -n 300 | (cd /tmp && gemini -p "$REVIEW_PROMPT" --skip-trust 2>/dev/null || true))"

if [ -z "$REVIEW" ]; then
  echo "⚠️  [post-commit] AI 코드 리뷰 생성에 실패했거나 응답이 비어 있습니다." >&2
  exit 0
fi

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "📌 [AI Code Review - $REV] $SUBJECT"
echo "════════════════════════════════════════════════════════════════"
echo "$REVIEW"
echo "════════════════════════════════════════════════════════════════"
echo ""

NOTE_TITLE="[코드리뷰][$REPO_NAME] $SUBJECT ($REV)"
NOTE_BODY="# [코드리뷰][$REPO_NAME] $SUBJECT ($REV)

- **저장소**: \`$REPO_NAME\`
- **커밋**: \`$REV\`
- **작성자**: $AUTHOR
- **일시**: $COMMIT_DATE

---

$REVIEW
"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SAVE_SCRIPT="$SCRIPT_DIR/save_to_bullsnote.py"

if [ -f "$SAVE_SCRIPT" ]; then
  echo "$NOTE_BODY" | python3 "$SAVE_SCRIPT" "$NOTE_TITLE" "코드리뷰,$REPO_NAME" || true
fi

exit 0
