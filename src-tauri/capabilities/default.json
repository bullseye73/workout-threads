{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창 권한",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$APPDATA/**" }] }
  ]
}
